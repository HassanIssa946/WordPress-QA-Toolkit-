    "doctor": "node bin/wpqa.mjs doctor",
    "setup:php": "composer install"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.14.0",
    "stylelint": "^18.0.0",
    "stylelint-config-recommended": "^19.0.0"
  }
}
