{
  "name": "wordpress-qa-toolkit",
  "version": "1.0.0",
  "description": "Reusable WordPress QA, security, performance and infrastructure audit toolkit, driven by Claude Code (/wp-audit).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "wpqa": "bin/wpqa.mjs"
  },
  "engines": {
    "node": ">=22.22.0"
